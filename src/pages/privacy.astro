---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Privacy Policy | Heating Repair Mooresville NC';
const description = 'Privacy policy for heatingrepairmooresvillenc.us. How we handle information submitted through our website.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Privacy Policy</span>
      </nav>
      <h1>Privacy Policy</h1>
      <p>Last updated: November 2026</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:800px;">
      <p>
        This Privacy Policy describes how Heating Repair Mooresville NC (“we,” “us,” or “our”) collects, uses, and protects information when you visit heatingrepairmooresvillenc.us or contact us through the site.
      </p>
      <h2>Information We Collect</h2>
      <p>
        When you use our contact form, you may provide your name, email address, phone number, and a message. We use this information solely to respond to your inquiry and provide the requested service.
      </p>
      <p>
        We may also collect standard server log information such as IP address, browser type, and pages visited. This data is used for site operation and security.
      </p>
      <h2>How We Use Information</h2>
      <ul>
        <li>To respond to service requests and questions</li>
        <li>To schedule and perform heating work</li>
        <li>To improve our website and services</li>
        <li>To comply with legal obligations</li>
      </ul>
      <h2>Sharing of Information</h2>
      <p>
        We do not sell your personal information. We may share information with service providers who help us operate the website or deliver service (for example, a form processing service), and only as needed for those purposes. We may also disclose information if required by law.
      </p>
      <h2>Cookies and Analytics</h2>
      <p>
        Our site may use essential cookies for basic functionality. If we use analytics tools in the future, they will be configured with privacy in mind, and this policy will be updated accordingly.
      </p>
      <h2>Data Security</h2>
      <p>
        We take reasonable steps to protect information submitted through our site. No method of transmission over the internet is completely secure, and we cannot guarantee absolute security.
      </p>
      <h2>Your Choices</h2>
      <p>
        You may contact us to request access to or correction of personal information we hold about you, or to ask that we delete it, subject to any legal retention requirements.
      </p>
      <h2>Contact</h2>
      <p>
        For privacy-related questions, please use our <a href="/contact/">contact form</a> or write to us at 143 Rolling Hill Rd A, Mooresville, NC 28117.
      </p>
      <h2>Changes</h2>
      <p>
        We may update this policy from time to time. The “Last updated” date at the top will reflect the most recent revision.
      </p>
    </div>
  </section>
</BaseLayout>
